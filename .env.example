# Docker Host Ports (Unique dedicated ports to prevent collision with other projects)
FRONTEND_PORT=38180
BACKEND_PORT=38150
MONGO_PORT=38127

# Backend Configuration
# REQUIRED. No default in docker-compose.yml — the server container runs with
# NODE_ENV=production and exits at startup if this is missing or < 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Password-reset email (Resend). The compose server runs with NODE_ENV=production,
# so without a key reset links are NOT printed — run the server with `npm run dev` for that.
RESEND_API_KEY=
EMAIL_FROM=MeetNet <no-reply@themeetnet.com>

# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* variables reach the app, and they are
# bundled into it in plain text: never put secrets here.
#
# USB (after `adb reverse tcp:5000 tcp:5000`):
EXPO_PUBLIC_API_URL=http://localhost:5000/api
# Same Wi-Fi instead: EXPO_PUBLIC_API_URL=http://<your PC's LAN IP>:5000/api
# Production API:      EXPO_PUBLIC_API_URL=https://surajya.onrender.com/api

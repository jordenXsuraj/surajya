# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database (connects to unique MongoDB port if using host port)
MONGO_URI=mongodb://localhost:38127/nexusnetwork

# Client URLs (CORS) - Includes unique frontend port
CLIENT_URL=http://localhost:38180
FRONTEND_URL=http://localhost:38180

# Authentication — REQUIRED, min 32 chars (server exits in production otherwise)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin Configuration
ADMIN_EMAIL=
ADMIN_SECRET_KEY=

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public web URL used in emailed links (password reset). Production: https://themeetnet.com
PUBLIC_APP_URL=http://localhost:5173

# Email (Resend). Without RESEND_API_KEY outside production, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=MeetNet <no-reply@themeetnet.com>

# Replies to MeetNet emails (themeetnet.com has no inbox). Optional.
EMAIL_REPLY_TO=

# Email verification: accounts created at/after this ISO time must verify before posting.
# Empty = the release time hard-coded in middleware/requireVerifiedEmail.js
VERIFICATION_REQUIRED_FROM=

# Optional Resend webhook (bounces/complaints). Empty = /api/webhooks/resend returns 404.
RESEND_WEBHOOK_SECRET=

# Expo push. Optional: only needed if "Enhanced push security" is enabled in the Expo project.
EXPO_ACCESS_TOKEN=

# Real client IP for rate limits (see docs/DEPLOYMENT.md, "Client IP").
# Empty = use req.ip. Only name a header your proxies overwrite, e.g. cf-connecting-ip.
CLIENT_IP_HEADER=
# Only with CLIENT_IP_HEADER=x-forwarded-for: which entry to use; negative counts from the right (-1 = last).
CLIENT_IP_XFF_INDEX=
# TEMPORARY: 1 enables GET /api/_debug/ip (admin key + admin JWT). Remove after choosing CLIENT_IP_HEADER.
DEBUG_IP_ROUTE=

# Mobile app config (GET /api/app/config). Versions are x.y.z; invalid values use the default.
APP_MIN_VERSION_ANDROID=0.0.0
APP_MIN_VERSION_IOS=0.0.0
APP_LATEST_VERSION_ANDROID=1.0.0
APP_LATEST_VERSION_IOS=1.0.0
APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.themeetnet.app
APP_STORE_URL_IOS=
# Booleans accept 1/0, true/false
APP_CONFESSIONS_ANDROID=true
APP_CONFESSIONS_IOS=true
APP_PDF_UPLOADS=true
APP_MAINTENANCE=false
APP_MAINTENANCE_MESSAGE=
